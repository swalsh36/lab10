  select(city, state, distance_km)


flextable(top5_far_from_mexico)




```

```{r}
canada_border <- north_america %>%
  filter(admin == "Canada") %>%
  st_union() %>%
  st_cast("MULTILINESTRING")


cities_conus_eqdc <- cities_conus_eqdc %>%
  mutate(dist_to_canada = as.numeric(st_distance(geometry, canada_border)))


library(flextable)

top5_far_from_canada <- cities_conus_eqdc %>%
  arrange(desc(dist_to_canada)) %>%
  select(city = state_name.x, state = state_name.x, distance_m = dist_to_canada) %>%
  slice_head(n = 5) %>%
  mutate(distance_km = round(distance_m / 1000, 1)) %>%
  select(city, state, distance_km)


flextable(top5_far_from_canada)


```

```{r}
library(tidyverse)
library(sf)
library(ggrepel)


top_10_cities_sf <- cities_conus_eqdc %>%
  arrange(desc(population)) %>%
  slice_head(n = 10)

top_10_cities_sf <- st_transform(top_10_cities_sf, crs = eqdc)

top_10_cities_sf_coords <- st_coordinates(top_10_cities_sf)

top_10_cities_sf <- cbind(top_10_cities_sf, top_10_cities_sf_coords)


ggplot() +
  geom_sf(data = north_america, fill = "lightgray", color = "black", lwd = 0.5) +  
  geom_sf(data = conus_states, fill = "transparent", color = "blue", lty = "dashed", lwd = 0.5) +  
  
  
  geom_sf(data = top_10_cities_sf, aes(color = state_name.x), size = 3, shape = 21, fill = "yellow") +  
  

  geom_label_repel(data = top_10_cities_sf, 
                   aes(x = X, y = Y, label = city),  
                   box.padding = 0.5, point.padding = 1, max.overlaps = 10) +
  

  theme_minimal() +
  labs(title = "Map of 10 Largest Cities in the USA", subtitle = "By Population") +
  theme(legend.position = "none")





```

```{r}
library(tidyverse)
library(sf)
library(ggrepel)
library(gghighlight)

top_10_cities_sf <- cities_conus_eqdc %>%
  arrange(desc(population)) %>%
  slice_head(n = 10)


cities_conus_eqdc <- st_transform(cities_conus_eqdc, st_crs(conus_states))


combined_state_borders <- st_combine(conus_states) %>% st_cast("MULTILINESTRING") %>% st_make_valid()


cities_conus_eqdc <- st_make_valid(cities_conus_eqdc)


cities_conus_eqdc <- cities_conus_eqdc %>%
  mutate(dist_to_national_border = as.numeric(st_distance(geometry, combined_state_borders)))


farthest_cities <- cities_conus_eqdc %>%
  slice_max(dist_to_national_border, n = 5)


ggplot() +
  geom_sf(data = north_america, fill = "lightgray", color = "black", lwd = 0.5) +  
  geom_sf(data = conus_states, fill = "transparent", color = "blue", lty = "dashed", lwd = 0.5) +  
  geom_sf(data = cities_conus_eqdc, aes(color = dist_to_national_border), size = 2, shape = 21, fill = "yellow") +  
  geom_label_repel(data = farthest_cities, 
                   aes(geometry = geometry, label = city_ascii),
                   stat = "sf_coordinates",
                   box.padding = 0.5, point.padding = 1, max.overlaps = 10) +
  scale_color_viridis_c() +  
  theme_minimal() +
  labs(
    title = "USA Cities Colored by Distance from National Border",
    subtitle = "Top 5 Farthest Cities Labeled",
    color = "Distance (m)"
  ) +
  theme(legend.position = "bottom")

```

```{r}
library(tidyverse)
library(sf)
library(ggrepel)


state_borders_multiline <- conus_states %>%
  st_geometry() %>%
  st_cast("MULTILINESTRING") %>%
  st_union() %>%
  st_sf(geometry = .)

cities_conus_eqdc <- st_transform(cities_conus_eqdc, st_crs(state_borders_multiline))

cities_conus_eqdc <- cities_conus_eqdc %>%
  mutate(dist_to_state_border = as.numeric(st_distance(geometry, state_borders_multiline)))

farthest_cities_state <- cities_conus_eqdc %>%
  slice_max(dist_to_state_border, n = 5)


ggplot() +
  geom_sf(data = conus_states, fill = "white", color = "black", lwd = 0.3) +
  
  
  geom_sf(data = cities_conus_eqdc, aes(color = dist_to_state_border), size = 2) +
  
  
  geom_label_repel(data = farthest_cities_state,
                   aes(label = city_ascii, geometry = geometry),
                   stat = "sf_coordinates",
                   min.segment.length = 0,
                   box.padding = 0.5, 
                   max.overlaps = 10) +
  
  scale_color_viridis_c(name = "Distance to State Border (m)") +
  labs(title = "Distance of US Cities to Nearest State Border",
       subtitle = "Top 5 Cities Farthest from Any State Border Highlighted") +
  theme_minimal()





```

```{r}

library(tidyverse)
library(sf)
library(ggrepel)


cities_conus_eqdc <- cities_conus_eqdc %>%
  mutate(dist_diff_mex_can = abs(dist_to_mexico - dist_to_canada))


equidistant_cities <- cities_conus_eqdc %>%
  filter(dist_diff_mex_can <= 100000)


top_5_equidistant <- equidistant_cities %>%
  slice_max(order_by = population, n = 5)


ggplot() +
  geom_sf(data = conus_states, fill = "white", color = "gray70", size = 0.3) +
  
  
  geom_sf(data = cities_conus_eqdc, color = "lightgray", size = 0.5) +
  
  
  geom_sf(data = equidistant_cities, aes(color = dist_diff_mex_can), size = 2) +
  
  
  geom_label_repel(
    data = top_5_equidistant,
    aes(label = city_ascii, geometry = geometry),
    stat = "sf_coordinates",
    min.segment.length = 0,
    box.padding = 0.5,
    max.overlaps = 10,
    fill = "white"
  ) +
  
  scale_color_viridis_c(name = "Dist Diff (m)", option = "C") +
  labs(
    title = "Cities Equidistant (~100 km) from Mexican & Canadian Borders",
    subtitle = "Top 5 Most Populous Cities in this Zone"
  ) +
  theme_minimal()




```



#Question 4: Based on the code below there are 8,638 cities within the 100 miles of the national border. There is also a total population of 207,764,429 within the 100 miles of the border. The percentage of the total city populatio in this zone is 51.64%. Based on the article, my numbers are slightly greater than the article becuase the article says "about 200 million people". However is also says 2/3 Americas population lives within the 100 mile range which is greater than 51.64%. So my conclusion is that one of our numbers does not make sense because the my data and the data from the article contridict each other.



```{r}

library(tidyverse)
library(sf)
library(scales)


border_zone_threshold <- 160934


cities_in_border_zone <- cities_conus_eqdc %>%
  filter(dist_to_national_border <= border_zone_threshold)


num_cities_in_zone <- nrow(cities_in_border_zone)


population_in_zone <- sum(cities_in_border_zone$population, na.rm = TRUE)


total_population <- sum(cities_conus_eqdc$population, na.rm = TRUE)


percent_in_zone <- (population_in_zone / total_population) * 100


cat("Number of cities within 100 miles of the national border:", num_cities_in_zone, "\n")
cat("Total population within the zone:", comma(population_in_zone), "\n")
cat("Percentage of total city population in the zone:", round(percent_in_zone, 2), "%\n")



```

```{r}
library(tidyverse)
library(sf)
library(ggrepel)
library(gghighlight)
library(scales)


border_zone_threshold <- 160934


cities_in_danger_zone <- cities_conus_eqdc %>%
  filter(dist_to_national_border <= border_zone_threshold)


top10_danger_zone <- cities_in_danger_zone %>%
  slice_max(order_by = population, n = 10)


ggplot() +
  geom_sf(data = conus_states, fill = "gray90", color = "gray50", size = 0.3) +

  
  geom_sf(data = cities_in_danger_zone, aes(fill = population), color = "black", shape = 21, size = 2, stroke = 0.2) +

  
  gghighlight(population %in% top10_danger_zone$population, use_direct_label = FALSE) +

  
  geom_label_repel(data = top10_danger_zone,
                   aes(geometry = geometry, label = city_ascii),
                   stat = "sf_coordinates",
                   size = 3,
                   box.padding = 0.5,
                   max.overlaps = 10) +

  
  scale_fill_gradient(low = "orange", high = "darkred", trans = "log10", labels = comma) +

  labs(
    title = "Cities Within 100 Miles of U.S. Border (\"Danger Zone\")",
    subtitle = "Top 10 Most Populous Cities Highlighted",
    fill = "Population"
  ) +
  theme_minimal() +
  theme(legend.position = "right")



```

